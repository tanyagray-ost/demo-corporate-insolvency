<https://w3id.org/rdfox-project-x-demo/vocab/nature-of-control>
    a skos:ConceptScheme ;
    dcterms:title "Companies House corporate PSC nature-of-control vocabulary"@en ;
    dcterms:description
        "Concepts observed in the Carillion corporate PSC ownership extract, preserving Companies House source codes as SKOS notations."@en ;
    dcterms:modified "2026-09-07"^^xsd:date ;
    skos:hasTopConcept
        noc:appointment-rights,
        noc:ownership-of-shares,
        noc:significant-influence-or-control-category,
        noc:surplus-asset-rights,
        noc:voting-rights .

