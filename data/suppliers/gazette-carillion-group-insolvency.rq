  # Corporate insolvency notice codes defined by The Gazette:
  # https://www.thegazette.co.uk/noticecodes
  VALUES ?noticeCode {
    # General corporate insolvency
    2401 2402 2403 2404 2405 2406 2407 2408 2409

    # Administration
    2410 2411 2412 2413 2414

    # Receivership
    2421 2422 2423 2424

    # Members' voluntary winding up
    2431 2432 2433 2434 2435

    # Creditors' voluntary winding up
    2441 2442 2443 2444 2445 2446 2447

    # Winding up by the court
    2450 2451 2452 2453 2454 2455 2456 2457
    2458 2459 2460 2461 2462 2463 2464 2465
  }

  BIND (
    IRI(
      CONCAT(
        "http://business.data.gov.uk/id/company/",
        ?targetCompanyNumber
      )
    )
    AS ?company
  )

  ?notice
    a gaz:Notice, ?noticeType ;
    gaz:isAbout ?matter ;
    gaz:hasNoticeCode ?noticeCode ;
    gaz:hasPublicationDate ?publicationDate .

  ?matter insolvency:hasCompany ?company .

  ?company
    gazorg:companyNumber ?companyNumber ;
    gazorg:name ?companyName .

  FILTER (
    STRSTARTS(
      STR(?noticeType),
      "https://www.thegazette.co.uk/def/insolvency#"
    )
  )
}
ORDER BY ?companyNumber DESC(?publicationDate)
