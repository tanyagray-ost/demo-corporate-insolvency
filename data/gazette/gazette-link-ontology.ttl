@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gaz: <https://www.thegazette.co.uk/def/publication#> .
@prefix gazlink: <https://w3id.org/rdfox-project-x-demo/ontology/gazette-link#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix psc: <https://w3id.org/rdfox-project-x-demo/ontology/psc#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/rdfox-project-x-demo/ontology/gazette-link>
    a owl:Ontology ;
    dcterms:title "Gazette company linkage ontology"@en ;
    dcterms:description
        "Terms for linking local Companies House company resources to Gazette company resources and insolvency notices."@en ;
    dcterms:modified "2026-09-07"^^xsd:date .

gazlink:gazetteCompanyResource
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain psc:Company ;
    rdfs:label "Gazette company resource"@en .

gazlink:hasInsolvencyNotice
    a owl:ObjectProperty ;
    rdfs:domain psc:Company ;
    rdfs:range gaz:Notice ;
    rdfs:label "has insolvency notice"@en .
