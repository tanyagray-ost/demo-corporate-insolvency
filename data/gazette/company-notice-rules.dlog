@prefix gaz: <https://www.thegazette.co.uk/def/publication#> .
@prefix gazlink: <https://w3id.org/rdfox-project-x-demo/ontology/gazette-link#> .
@prefix insolvency: <https://www.thegazette.co.uk/def/insolvency#> .
@prefix psc: <https://w3id.org/rdfox-project-x-demo/ontology/psc#> .

# Construct The Gazette company IRI from the PSC company number, preserving
# leading zeroes, and require the resulting resource to occur in an imported
# insolvency notice. This avoids relying on inconsistent companyNumber
# literals found in some Gazette notices.
[?company, gazlink:gazetteCompanyResource, ?gazetteCompany] :-
    [?company, psc:companyNumber, ?companyNumber],
    BIND(
        IRI(
            CONCAT(
                "http://business.data.gov.uk/id/company/",
                STR(?companyNumber)
            )
        )
        AS ?gazetteCompany
    ),
    [?notifiableThing, insolvency:hasCompany, ?gazetteCompany] .

# Assert a direct company-to-notice relationship. The notice IRI contains The
# Gazette notice ID, for example:
# https://www.thegazette.co.uk/id/notice/4237126
[?company, gazlink:hasInsolvencyNotice, ?notice] :-
    [?company, gazlink:gazetteCompanyResource, ?gazetteCompany],
    [?notice, gaz:isAbout, ?notifiableThing],
    [?notifiableThing, insolvency:hasCompany, ?gazetteCompany] .
