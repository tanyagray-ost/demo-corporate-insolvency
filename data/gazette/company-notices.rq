PREFIX gaz: <https://www.thegazette.co.uk/def/publication#>
PREFIX gazorg: <https://www.thegazette.co.uk/def/organisation#>
PREFIX gazlink: <https://w3id.org/rdfox-project-x-demo/ontology/gazette-link#>
PREFIX psc: <https://w3id.org/rdfox-project-x-demo/ontology/psc#>

SELECT DISTINCT
  ?company
  ?companyNumber
  ?gazetteCompany
  ?gazetteCompanyName
  ?notice
  ?noticeCode
  ?publicationDate
WHERE {
  ?company
    a psc:Company ;
    psc:companyNumber ?companyNumber ;
    gazlink:gazetteCompanyResource ?gazetteCompany ;
    gazlink:hasInsolvencyNotice ?notice .

  ?gazetteCompany gazorg:name ?gazetteCompanyName .

  ?notice gaz:hasNoticeCode ?noticeCode .
  OPTIONAL { ?notice gaz:hasPublicationDate ?publicationDate }
}
ORDER BY ?companyNumber DESC(?publicationDate) ?notice
